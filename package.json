{
  "name": "@zthun/works",
  "version": "0.0.0",
  "description": "The main website for zthunworks projects.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/works"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'docs' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-angular": "^21.2.3",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@zthun/janitor-eslint-config": "^21.2.4",
    "@zthun/janitor-ts-config": "^21.1.3",
    "@zthun/janitor-vite": "^21.2.4",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lerna": "^10.0.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.18.1"
}
