{
  "name": "@zthun/works",
  "version": "0.0.0",
  "description": "The main website for zthunworks projects.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/works"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'docs' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@zthun/janitor-build-config": "^19.5.6",
    "@zthun/janitor-lint": "^19.5.6",
    "@zthun/janitor-lint-config": "^19.5.6",
    "@zthun/janitor-options": "^19.5.6",
    "@zthun/janitor-ts-config": "^19.5.3",
    "happy-dom": "^20.4.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.3",
    "lodash-es": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0"
}
